# Server
PORT=8080
GIN_MODE=debug                      # use "release" in production

# MongoDB (local or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=swatch

# JWT secrets - generate with: openssl rand -hex 32
SECRET_KEY=
REFRESH_SECRET_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Comma-separated list of allowed browser origins (wildcards allowed, e.g. https://*.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173

# Recommendations
RECOMMENDATION_LIMIT=8
# Optional: load retrained model artifacts from disk instead of the embedded copies.
# MODEL_DIR=./internal/model/artifacts

# Seeded admin account (optional)
ADMIN_EMAIL=admin@swatch.dev
ADMIN_PASSWORD=
